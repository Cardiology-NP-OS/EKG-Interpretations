{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ekg-development-workflow-attempt-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receiptId", "observationAuthority", "observer", "source", "classification", "evaluationAttemptSignaturePresent", "candidateExecutionClaimed", "bundleValidityClaimed", "clinicalAccuracyClaimed", "capabilityNotClaim", "runtimeAuthority", "containsProtectedDatasetMetadata", "writeOnce", "externalObjectLockAttested"],
  "properties": {
    "schema": {"const": "ekg-development-workflow-attempt-receipt-v1"},
    "receiptId": {"type": "string", "pattern": "^github-actions:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+:[1-9][0-9]*:[1-9][0-9]*$"},
    "observationAuthority": {"const": "GITHUB_ACTIONS_CONTROL_PLANE_ONLY"},
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflowName", "workflowPath", "runId", "runAttempt", "headSha"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "workflowName": {"const": "Development ECG evaluation watchdog"},
        "workflowPath": {"const": ".github/workflows/development_evaluation_watchdog.yml"},
        "runId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "runAttempt": {"type": "integer", "minimum": 1},
        "headSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflowName", "workflowPath", "runId", "runAttempt", "event", "headSha", "status", "conclusion", "createdAtUtc", "updatedAtUtc", "htmlUrl"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "workflowName": {"const": "Development ECG evaluation"},
        "workflowPath": {"const": ".github/workflows/development_evaluation.yml"},
        "runId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "runAttempt": {"type": "integer", "minimum": 1},
        "event": {"enum": ["push", "schedule", "workflow_dispatch"]},
        "headSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "status": {"const": "completed"},
        "conclusion": {"enum": ["success", "failure", "cancelled", "timed_out", "action_required", "neutral", "skipped", "stale", "startup_failure"]},
        "createdAtUtc": {"type": "string", "format": "date-time"},
        "updatedAtUtc": {"type": "string", "format": "date-time"},
        "htmlUrl": {"type": "string", "pattern": "^https://github\\.com/"}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "preLaunchFailure", "evidence"],
      "properties": {
        "phase": {"enum": ["SYNTHETIC_BOUNDARY_NOT_PASSED", "FULL_DEVELOPMENT_NOT_STARTED", "GOVERNED_RESOURCE_PREFLIGHT_NOT_PASSED", "SIGNING_KEY_NOT_PREPARED", "RUN_CONFIGURATION_NOT_CREATED", "RUN_CONFIGURATION_STEP_COMPLETED", "EVALUATION_STEP_REACHED", "SOURCE_WORKFLOW_COMPLETED", "OBSERVATION_INCOMPLETE"]},
        "preLaunchFailure": {"type": ["boolean", "null"]},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["syntheticBoundaryConclusion", "fullDevelopmentConclusion", "governedResourcePreflight", "signingKeyPreparation", "runConfigurationStep", "evaluationStep", "reconciliationStep", "cleanupStep"],
          "properties": {
            "syntheticBoundaryConclusion": {"enum": ["SUCCESS", "FAILURE", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED", "NEUTRAL", "SKIPPED", "STALE", "STARTUP_FAILURE", "NOT_OBSERVED"]},
            "fullDevelopmentConclusion": {"enum": ["SUCCESS", "FAILURE", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED", "NEUTRAL", "SKIPPED", "STALE", "STARTUP_FAILURE", "NOT_OBSERVED"]},
            "governedResourcePreflight": {"enum": ["PASSED", "NOT_PASSED", "NOT_OBSERVED"]},
            "signingKeyPreparation": {"enum": ["PASSED", "NOT_PASSED", "NOT_OBSERVED"]},
            "runConfigurationStep": {"enum": ["PASSED", "NOT_PASSED", "NOT_OBSERVED"]},
            "evaluationStep": {"enum": ["PASSED", "NOT_PASSED", "NOT_OBSERVED"]},
            "reconciliationStep": {"enum": ["PASSED", "NOT_PASSED", "NOT_OBSERVED"]},
            "cleanupStep": {"enum": ["PASSED", "NOT_PASSED", "NOT_OBSERVED"]}
          }
        }
      }
    },
    "evaluationAttemptSignaturePresent": {"const": "NOT_OBSERVED"},
    "candidateExecutionClaimed": {"const": false},
    "bundleValidityClaimed": {"const": false},
    "clinicalAccuracyClaimed": {"const": false},
    "capabilityNotClaim": {"const": true},
    "runtimeAuthority": {"const": false},
    "containsProtectedDatasetMetadata": {"const": false},
    "writeOnce": {"const": false},
    "externalObjectLockAttested": {"const": false}
  }
}
